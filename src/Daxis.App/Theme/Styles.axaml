<!-- Component styles. Every value comes from Tokens.axaml; see DESIGN.md for the rules. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:app="using:Daxis.App">

  <!-- ── Base ─────────────────────────────────────────────────────────── -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{DynamicResource Bg1}" />
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
  </Style>
  <Style Selector="PopupRoot, OverlayPopupHost">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
  </Style>
  <Style Selector="app|Icon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <!-- ── Type roles ───────────────────────────────────────────────────── -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="-0.2" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource FgFaint}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource FgFaint}" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="TextBlock.danger, SelectableTextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
  </Style>

  <!-- ── Buttons: 6px, square-ish, one green per view ─────────────────── -->
  <Style Selector="Button">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="Foreground" Value="{DynamicResource FgFaint}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Brand}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrandHover}" />
    <Setter Property="Foreground" Value="{DynamicResource OnBrand}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrandHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrandHover}" />
    <Setter Property="Foreground" Value="{DynamicResource OnBrand}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="7" />
    <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
  </Style>
  <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
  </Style>

  <!-- Sidebar rows -->
  <Style Selector="Button.nav">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
  </Style>

  <!-- Editor tabs -->
  <Style Selector="ListBox.tabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem">
    <Setter Property="Padding" Value="12,0,6,0" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg1}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
  </Style>

  <!-- Tab close: dirty tabs show a dot that turns into × on hover -->
  <Style Selector="Panel.tabclose > Ellipse"><Setter Property="Opacity" Value="0" /></Style>
  <Style Selector="Panel.tabclose.dirty > Ellipse"><Setter Property="Opacity" Value="1" /></Style>
  <Style Selector="Panel.tabclose.dirty > Button"><Setter Property="Opacity" Value="0" /></Style>
  <Style Selector="ListBoxItem:pointerover Panel.tabclose.dirty > Ellipse"><Setter Property="Opacity" Value="0" /></Style>
  <Style Selector="ListBoxItem:pointerover Panel.tabclose.dirty > Button"><Setter Property="Opacity" Value="1" /></Style>

  <!-- Section switcher (lakehouse Tables / Files) -->
  <Style Selector="TabStripItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
  </Style>
  <Style Selector="TabStripItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
  </Style>

  <!-- Page switch: content fades in -->
  <Style Selector=":is(Control).page[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:0.28" Easing="CubicEaseOut" FillMode="Both">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Loading placeholder: breathes while the service answers (only while loading, so nothing loops when idle) -->
  <Style Selector="Border.skeleton">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="CornerRadius" Value="4" />
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Stepper: the running step's ring pulses -->
  <Style Selector="Ellipse.pulse">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- Entrance for stepper rows and result cards -->
  <Style Selector="Border.enter">
    <Style.Animations>
      <Animation Duration="0:0:0.25" Easing="CubicEaseOut" FillMode="Both">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="6" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Selectable list row (source control scan) -->
  <Style Selector="Button.row">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.row.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Selection}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
  </Style>
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
  </Style>
  <Style Selector="Border.pill.warn">
    <Setter Property="BorderBrush" Value="{DynamicResource Warning}" />
  </Style>
  <Style Selector="Border.pill.warn > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Warning}" />
  </Style>
  <Style Selector="Border.pill.danger">
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
    <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
  </Style>
  <Style Selector="Border.pill.danger > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
  </Style>
  <Style Selector="Border.callout">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.callout.danger">
    <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
  </Style>
  <Style Selector="Border.callout.warn">
    <Setter Property="BorderBrush" Value="{DynamicResource Warning}" />
  </Style>

  <!-- Text link (footer): faint, brand on hover, no chrome -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource BrandText}" />
  </Style>

  <!-- Floating toolbar over a canvas: hairline, no shadow -->
  <Style Selector="Border.floating">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="Border.floating > TextBlock">
    <Setter Property="Margin" Value="6,2" />
  </Style>

  <!-- ── Inputs ───────────────────────────────────────────────────────── -->
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brand}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- Object name in editor header: reads as a heading until focused -->
  <Style Selector="TextBox.title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="-0.2" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Margin" Value="-7,0,0,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.title:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
  </Style>
  <Style Selector="TextBox.title:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
  </Style>
  <Style Selector="ComboBox.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <!-- Workspace switcher: reads as breadcrumb text until focused -->
  <Style Selector="AutoCompleteBox.bare /template/ TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="8,5,28,5" />
  </Style>
  <Style Selector="AutoCompleteBox.bare /template/ TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="AutoCompleteBox.bare /template/ TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brand}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- ── Lists & trees ────────────────────────────────────────────────── -->
  <Style Selector="TreeView">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
    <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
  </Style>
  <Style Selector="TreeViewItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Selection}" />
  </Style>
  <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
  </Style>

  <!-- ── Surfaces ─────────────────────────────────────────────────────── -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,1" />
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill > TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
  </Style>
  <Style Selector="Border.pill.brand">
    <Setter Property="Background" Value="{DynamicResource BrandSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrandBorder}" />
  </Style>
  <Style Selector="Border.pill.brand > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource BrandText}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.banner">
    <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="20,10" />
  </Style>
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource Border}" />
    <Setter Property="MinWidth" Value="1" />
    <Setter Property="MinHeight" Value="1" />
  </Style>

  <!-- ── Code & data ──────────────────────────────────────────────────── -->
  <Style Selector="ae|TextEditor">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="{DynamicResource Bg1}" />
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    <Setter Property="LineNumbersForeground" Value="{DynamicResource FgFaint}" />
    <Setter Property="Padding" Value="4,8,0,0" />
  </Style>
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{DynamicResource Bg1}" />
    <Setter Property="GridLinesVisibility" Value="All" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Border}" />
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Border}" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="CanUserReorderColumns" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="DataGrid.mono DataGridCell">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource Bg0}" />
    <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,0" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource Selection}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
</Styles>
