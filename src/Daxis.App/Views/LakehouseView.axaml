<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Daxis.App"
             xmlns:core="using:Daxis.Core"
             x:Class="Daxis.App.Views.LakehouseView"
             x:DataType="app:LakehouseTab">
  <Panel>
    <DockPanel>
      <Border DockPanel.Dock="Top" Classes="banner" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <SelectableTextBlock Text="{Binding Error}" Classes="danger" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Retry" Command="{Binding ReloadCommand}" Margin="12,0,6,0" />
          <Button Grid.Column="2" Classes="ghost" Command="{Binding DismissErrorCommand}">
            <app:Icon Data="{x:Static app:Icons.Close}" />
          </Button>
        </Grid>
      </Border>

      <!-- Header -->
      <Border DockPanel.Dock="Top" Padding="20,14,16,0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8" Height="20">
                <Border Classes="pill brand"><TextBlock Text="Lakehouse" /></Border>
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding Tables.Count, StringFormat='{}{0} tables'}" />
              </StackPanel>
              <TextBlock Classes="h1" Text="{Binding Title}" FontSize="20" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
              <Button Classes="ghost" Command="{Binding ReloadCommand}" ToolTip.Tip="Reload">
                <app:Icon Data="{x:Static app:Icons.Refresh}" />
              </Button>
              <Button Classes="ghost" x:Name="OpenWeb" ToolTip.Tip="Open in Fabric">
                <app:Icon Data="{x:Static app:Icons.External}" />
              </Button>
            </StackPanel>
          </Grid>

          <!-- Connection details -->
          <Grid ColumnDefinitions="*,12,*,12,*">
            <Border Classes="card" Padding="12,10">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="ghost copy" Tag="{Binding Info.SqlEndpoint, FallbackValue=''}" ToolTip.Tip="Copy">
                  <app:Icon Data="{x:Static app:Icons.Copy}" Width="14" Height="14" />
                </Button>
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="SQL ENDPOINT" />
                  <TextBlock Classes="mono" Text="{Binding Info.SqlEndpoint, FallbackValue='—'}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Grid.Column="2" Classes="card" Padding="12,10">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="ghost copy" Tag="{Binding Info.TablesPath, FallbackValue=''}" ToolTip.Tip="Copy">
                  <app:Icon Data="{x:Static app:Icons.Copy}" Width="14" Height="14" />
                </Button>
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="ONELAKE TABLES" />
                  <TextBlock Classes="mono" Text="{Binding Info.TablesPath, FallbackValue='—'}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Grid.Column="4" Classes="card" Padding="12,10">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="ghost copy" Tag="{Binding Info.FilesPath, FallbackValue=''}" ToolTip.Tip="Copy">
                  <app:Icon Data="{x:Static app:Icons.Copy}" Width="14" Height="14" />
                </Button>
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="ONELAKE FILES" />
                  <TextBlock Classes="mono" Text="{Binding Info.FilesPath, FallbackValue='—'}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </Border>
          </Grid>

          <TabStrip SelectedIndex="{Binding Section}" Margin="-12,0,0,0">
            <TabStripItem Content="Tables" />
            <TabStripItem Content="Files" />
          </TabStrip>
        </StackPanel>
      </Border>

      <Panel>
        <!-- Tables -->
        <Panel IsVisible="{Binding Section, Converter={x:Static app:Conv.IsZero}}">
          <DataGrid ItemsSource="{Binding Tables}" x:CompileBindings="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
              <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
              <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="*" />
              <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="4*" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="{Binding TablesMessage}" Classes="muted" TextWrapping="Wrap" MaxWidth="560"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                     IsVisible="{Binding TablesMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Panel>

        <!-- Files -->
        <DockPanel IsVisible="{Binding Section}">
          <Border DockPanel.Dock="Top" Background="{DynamicResource Bg0}" BorderBrush="{DynamicResource Border}"
                  BorderThickness="0,0,0,1" Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Classes="ghost" Command="{Binding UpCommand}" ToolTip.Tip="Up one level">
                <app:Icon Data="{x:Static app:Icons.Up}" />
              </Button>
              <Button Classes="ghost" Command="{Binding ReloadFilesCommand}" ToolTip.Tip="Reload">
                <app:Icon Data="{x:Static app:Icons.Refresh}" />
              </Button>
              <TextBlock Classes="mono" Text="{Binding Path}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
          </Border>
          <Panel>
            <DataGrid x:Name="FilesGrid" ItemsSource="{Binding Files}">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="3*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="core:OneLakeEntry">
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="10,0" VerticalAlignment="Center">
                        <app:Icon Data="{x:Static app:Icons.Folder}" Width="14" Height="14" IsVisible="{Binding IsDirectory}"
                                  Foreground="{DynamicResource BrandText}" />
                        <app:Icon Data="{x:Static app:Icons.File}" Width="14" Height="14" IsVisible="{Binding !IsDirectory}"
                                  Foreground="{DynamicResource FgMuted}" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Size" Binding="{Binding Size, Converter={x:Static app:Conv.Bytes}}" Width="*" x:DataType="core:OneLakeEntry" />
                <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="2*" x:DataType="core:OneLakeEntry" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding FilesMessage}" Classes="muted" TextWrapping="Wrap" MaxWidth="560"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       IsVisible="{Binding FilesMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </Panel>
        </DockPanel>
      </Panel>
    </DockPanel>

    <Border Background="{DynamicResource Bg1}" Opacity="0.92" IsVisible="{Binding IsBusy}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <ProgressBar IsIndeterminate="True" Width="160" Height="2" MinHeight="2" />
        <TextBlock Text="{Binding BusyText}" Classes="muted" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Panel>
</UserControl>
